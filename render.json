{
  "services": [
    {
      "type": "web",
      "name": "fileduck-api",
      "serviceId": "srv-d65vqkkr85hc73d2t050",
      "runtime": "docker",
      "plan": "standard",
      "region": "oregon",
      "buildCommand": "",
      "startCommand": "node dist/server.js",
      "healthCheckPath": "/api/health",
      "healthCheckTimeout": 30,
      "restartPolicy": "on_failure",
      "maxRetries": 3,
      "dockerfile": "./apps/api/Dockerfile",
      "dockerContext": "./",
      "autoDeploy": true,
      "branch": "main",
      "preDeployCommand": "",
      "envVars": {
        "PORT": "3001",
        "NODE_ENV": "production",
        "AWS_REGION": "us-east-1",
        "S3_BUCKET_QUARANTINE": "fileduck-quarantine",
        "S3_BUCKET_PUBLIC": "fileduck-public",
        "CLAMAV_HOST": "localhost",
        "CLAMAV_PORT": "3310",
        "RATE_LIMIT_WINDOW_MS": "60000",
        "RATE_LIMIT_MAX_REQUESTS": "10",
        "SCANNER_PORT": "4000",
        "SCANNER_URL": "http://localhost:4000",
        "USE_CDN": "false",
        "VITE_API_URL": "/api"
      },
      "secretEnvVars": {
        "UPSTASH_REDIS_URL": "",
        "UPSTASH_REDIS_TOKEN": "",
        "AWS_ACCESS_KEY_ID": "",
        "AWS_SECRET_ACCESS_KEY": "",
        "AWS_ENDPOINT": "",
        "VIRUSTOTAL_API_KEY": "",
        "JWT_SECRET": "",
        "CAPTCHA_SITE_KEY": "",
        "CAPTCHA_SECRET_KEY": "",
        "MINIO_LICENSE": ""
      }
    }
  ]
}
